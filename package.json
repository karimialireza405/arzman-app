{
  "name": "arzman",
  "version": "0.2.0",
  "private": true,
  "description": "ArzMan (ارز من) — Persian-first live currency dashboard for the Iranian open market",
  "author": "Alireza Karimi <alirezkarimi0021@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/karimialireza405/arzman-app#readme",
  "bugs": {
    "url": "https://github.com/karimialireza405/arzman-app/issues"
  },
  "keywords": [
    "iran",
    "currency",
    "exchange-rate",
    "toman",
    "rial",
    "persian",
    "farsi",
    "rtl",
    "expo",
    "react-native",
    "cloudflare-workers",
    "durable-objects",
    "tgju"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karimialireza405/arzman-app.git"
  },
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "server"
  ],
  "scripts": {
    "start": "npm run start -w @arzman/mobile",
    "server": "npm run dev -w @arzman/server",
    "typecheck": "tsc --noEmit -p packages/shared && tsc --noEmit -p server && tsc --noEmit -p apps/mobile",
    "lint": "eslint .",
    "test": "vitest run",
    "verify": "npx tsx scripts/verify-market.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "build:web": "npm run build:web -w @arzman/mobile",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.8",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "tsx": "^4.19.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  }
}
