{
  "expo": {
    "name": "ارز من",
    "slug": "arzman",
    "scheme": "arzman",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.arzman.personal",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": [
          "fa",
          "en"
        ]
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-font"
    ],
    "extra": {
      "supportsRTL": true,
      "router": {},
      "eas": {
        "projectId": "b55903ac-8938-4cdf-9dd0-581fe0c53d8f"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "owner": "alirezkarimi"
  }
}
